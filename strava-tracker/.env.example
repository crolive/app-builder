# PostgreSQL connection string (Neon). Include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Base URL of the deployed app (or http://localhost:3000 in dev)
NEXTAUTH_URL="http://localhost:3000"

# Strava API app credentials (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID="replace-with-strava-client-id"
STRAVA_CLIENT_SECRET="replace-with-strava-client-secret"

# Arbitrary shared secret you choose; used to validate the Strava webhook
# subscription handshake (hub.verify_token). Must match the value passed
# when creating the subscription via scripts/create-webhook-subscription.mjs
STRAVA_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"

# IANA timezone string used as the single, app-wide timezone for computing
# leaderboard time-window boundaries (1 day / 1 week / 1 month).
APP_TIMEZONE="America/New_York"
