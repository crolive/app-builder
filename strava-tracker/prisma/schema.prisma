generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
}

enum ActivitySource {
  strava
  manual
}

// Strava OAuth tokens (accessToken/refreshToken/tokenExpiresAt) live here and
// are the single source of truth that all token-refresh logic reads/writes.
// This app uses NextAuth's JWT session strategy (no database sessions), so
// NextAuth's own Account/Session/VerificationToken tables are not needed.
model User {
  id                   String            @id @default(cuid())
  stravaAthleteId      String            @unique
  firstName            String
  lastName             String
  profilePhotoUrl      String?
  accessToken          String?
  refreshToken         String?
  tokenExpiresAt       DateTime?
  connectionStatus     ConnectionStatus  @default(CONNECTED)
  hasCompletedBackfill Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  activities Activity[]
}

// Maintained by the app owner via direct DB edits (SQL client / Prisma
// Studio). No in-app admin UI manages this table.
model AllowlistedAthlete {
  id              String   @id @default(cuid())
  stravaAthleteId String   @unique
  note            String?
  createdAt       DateTime @default(now())
}

model Activity {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  source             ActivitySource
  stravaActivityId   String?        @unique
  type               String
  title              String
  distanceMiles      Float
  movingTimeSeconds  Int
  elapsedTimeSeconds Int
  startDate          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId])
  @@index([startDate])
}

// Write-only log of every raw incoming webhook payload, for debugging.
// No in-app UI reads from this table in this build.
model WebhookEvent {
  id             String   @id @default(cuid())
  objectType     String?
  objectId       String?
  aspectType     String?
  ownerId        String?
  subscriptionId String?
  eventTime      DateTime?
  rawPayload     Json
  receivedAt     DateTime @default(now())
}
